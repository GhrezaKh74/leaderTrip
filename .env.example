# نمونهٔ تنظیمات. کپی کنید به `.env` و مقدارها را عوض کنید:
#
#   cp .env.example .env
#
# فایل `.env` در گیت نیست و نباید باشد.

# ─── پایگاه داده ───────────────────────────────────────────────
# اجباری است و پیش‌فرض ندارد: رمز پیش‌فرض روی یک سرویس واقعی، یعنی بدون رمز.
POSTGRES_PASSWORD=
POSTGRES_DB=leadertrip
POSTGRES_USER=leadertrip

# ─── پورت‌ها ───────────────────────────────────────────────────
PORT=8080
API_PORT=8081

# ─── بک‌اند ────────────────────────────────────────────────────
# مبدأیی که مرورگر از آن API را صدا می‌زند. خالی یعنی CORS بسته است.
WEB_ORIGIN=http://localhost:8080

# کلید اندپوینت‌های مدیریتی (به‌روزرسانی قیمت‌ها).
# خالی بگذارید تا آن اندپوینت‌ها اصلاً ثبت نشوند — این امن‌ترین حالت است.
# برای ساختن کلید:  openssl rand -base64 32
ADMIN_API_KEY=

ASPNETCORE_ENVIRONMENT=Production
