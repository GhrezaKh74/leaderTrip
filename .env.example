# نمونهٔ تنظیمات. کپی کنید به `.env` و مقدارها را عوض کنید:
#
#   cp .env.example .env
#
# فایل `.env` در گیت نیست و نباید باشد.

# ─── پایگاه داده ───────────────────────────────────────────────
# اجباری است و پیش‌فرض ندارد: رمز پیش‌فرض روی یک سرویس واقعی، یعنی بدون رمز.
POSTGRES_PASSWORD=
POSTGRES_DB=leadertrip
POSTGRES_USER=leadertrip

# ─── پورت‌ها ───────────────────────────────────────────────────
PORT=8080
API_PORT=8081

# ─── بک‌اند ────────────────────────────────────────────────────
# مبدأیی که مرورگر از آن API را صدا می‌زند. رابط کاربری /api را از همان
# مبدأ خودش پروکسی می‌کند، پس این فقط برای صدازدن «مستقیم» API از مرورگر
# (پورت ۸۰۸۱) لازم است. خالی یعنی CORS بسته.
WEB_ORIGIN=http://localhost:8080

# کلید پنل مدیریت (/?admin — قیمت‌ها، عکس‌ها، نمای کلی).
# خالی بگذارید تا اندپوینت‌های مدیریتی اصلاً ثبت نشوند — امن‌ترین حالت.
# برای ساختن کلید:  openssl rand -base64 32
ADMIN_API_KEY=

ASPNETCORE_ENVIRONMENT=Production
